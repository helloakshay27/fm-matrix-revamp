# fm-matrix-revamp environment variables
# Copy to .env and fill in values. Never commit .env.
# NOTE: every VITE_* value is bundled into the public JavaScript served to browsers.
#       Use this only for values that are meant to be visible to site visitors (demo logins).

# Helpdesk integration (src/api/client.ts) - TEMPORARY: should move to the backend
VITE_HELPDESK_INTEGRATION_KEY=

# Superset embedded dashboard (src/components/SupersetDashboard.tsx) - TEMPORARY: use backend guest tokens
VITE_SUPERSET_TOKEN=

# Demo login passwords shown on product pages.
